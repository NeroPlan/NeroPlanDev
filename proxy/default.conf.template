# nginx 공식 이미지가 시작 시 환경변수를 치환해 /etc/nginx/conf.d/default.conf로 생성
# compose: http://backendPlan:8080 / Railway: http://backendplan.railway.internal:8080 처럼 서비스 주소를 환경변수로 주입

# Railway는 앞단에서 TLS를 종료하고 http로 넘겨주므로, 받은 X-Forwarded-Proto(https)를 그대로 백엔드에 전달
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen       80;
    listen  [::]:80; #위의 포트랑 일치해야하고 docker run을 했을 때 서버 포트와 일치해야한다.
    server_name  localhost;

    # 서비스가 재배포되면 내부 IP가 바뀌므로 요청마다 DNS를 다시 조회
    # NGINX_LOCAL_RESOLVERS는 nginx 이미지가 /etc/resolv.conf에서 읽어 채움 (Dockerfile의 NGINX_ENTRYPOINT_LOCAL_RESOLVERS)
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend_plan ${BACKEND_PLAN_URL};
    set $backend_user ${BACKEND_USER_URL};
    set $frontend ${FRONTEND_URL};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    # Spring은 X-Forwarded-Proto를 받으면 포트를 기본값(80/443)으로 바꾸므로 포트가 포함된 호스트를 함께 전달
    # 없으면 로컬(localhost:8080)에서 OAuth 리다이렉트가 http://localhost/...로 가서 로그인이 안 됨
    proxy_set_header X-Forwarded-Host $http_host;

     # API 요청은 Spring Boot로 전달
    location /api/v1/plans {
        proxy_pass $backend_plan;
    }

    location /api/v1/users {
        proxy_pass $backend_user;
    }

    # 구글 로그인 - 시작(/api/v1/auth, /oauth2)과 구글 콜백(/login/oauth2)을 모두 backendUser로 전달
    location /api/v1/auth {
        proxy_pass $backend_user;
    }

    location /oauth2/ {
        proxy_pass $backend_user;
    }

    location /login/oauth2/ {
        proxy_pass $backend_user;
    }

    location / { #웹주소에 따라 어떤 html파일을 사용자에게 보여줄 것인지 설정하는 부분
        proxy_pass $frontend;
    }

    #error_page  404              /404.html;

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }

}
